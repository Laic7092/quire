{
  "name": "layx-reader",
  "identifier": "com.laix.layxreader",
  "version": "0.1.0",
  "i18n": {
    "dir": "locales",
    "source": "en"
  },
  "copyright": "© 2026 Laix",
  "out": "build",
  "fileAssociations": [
    {
      "ext": [
        "epub"
      ],
      "name": "EPUB eBook",
      "mimeType": "application/epub+zip",
      "role": "Viewer"
    },
    {
      "ext": [
        "txt"
      ],
      "name": "Plain Text",
      "mimeType": "text/plain",
      "role": "Viewer"
    }
  ],
  "macos": {
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.books"
    }
  }
}
